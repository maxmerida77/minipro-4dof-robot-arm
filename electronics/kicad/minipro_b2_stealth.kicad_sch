  (text "Alimentacion: Cargador UGREEN 50W (USB-C a USB-C) -> AR5515 (DIP en 5V) -> Boton KCD11-2P -> Bus +5V_SERVO (3A)" (exclude_from_sim no) (at 25.40 28.20 0) (effects (font (size 1.30 1.30)) (justify left top)) (uuid "6c4cd63a-dacb-536f-8e82-894e9275a61c"))
  (text "REGLAS CRITICAS DE BANCO:" (exclude_from_sim no) (at 25.40 162.56 0) (effects (font (size 1.40 1.40) (bold yes)) (justify left top)) (uuid "89a7fb92-65f8-5cf5-b443-f18d62e6a87c"))
